<?xml version="1.0" encoding="UTF-8"?>

<soap:Envelope
    xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
    xmlns:pay="http://campuseats.example.com/payment">

    <soap:Header>
        <pay:Credentials>
            <pay:username>campuseats_client</pay:username>
            <pay:password>demo-password</pay:password>
        </pay:Credentials>
    </soap:Header>

    <soap:Body>
        <pay:charge>
            <pay:orderId>CE-1001</pay:orderId>
            <pay:amount>500.00</pay:amount>
            <pay:currency>INR</pay:currency>
            <pay:cardNumber>4111111111111111</pay:cardNumber>
        </pay:charge>
    </soap:Body>

</soap:Envelope>