<?xml version="1.0" encoding="UTF-8"?>

<definitions
    xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="http://campuseats.example.com/payment"
    targetNamespace="http://campuseats.example.com/payment"
    name="PaymentGatewayService">

    <!-- TYPES -->
    <types>
        <xsd:schema
            targetNamespace="http://campuseats.example.com/payment">

            <xsd:element name="charge">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="orderId" type="xsd:string"/>
                        <xsd:element name="amount" type="xsd:decimal"/>
                        <xsd:element name="currency" type="xsd:string"/>
                        <xsd:element name="cardNumber" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="chargeResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="transactionId" type="xsd:string"/>
                        <xsd:element name="status" type="xsd:string"/>
                        <xsd:element name="message" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

        </xsd:schema>
    </types>

    <!-- MESSAGES -->
    <message name="ChargeRequest">
        <part name="parameters" element="tns:charge"/>
    </message>

    <message name="ChargeResponse">
        <part name="parameters" element="tns:chargeResponse"/>
    </message>

    <!-- PORT TYPE -->
    <portType name="PaymentPortType">
        <operation name="charge">
            <input message="tns:ChargeRequest"/>
            <output message="tns:ChargeResponse"/>
        </operation>
    </portType>

    <!-- BINDING -->
    <binding name="PaymentSoapBinding" type="tns:PaymentPortType">

        <soap:binding
            style="document"
            transport="http://schemas.xmlsoap.org/soap/http"/>

        <operation name="charge">
            <soap:operation
                soapAction="http://campuseats.example.com/payment/charge"/>

            <input>
                <soap:body use="literal"/>
            </input>

            <output>
                <soap:body use="literal"/>
            </output>
        </operation>

    </binding>

    <!-- SERVICE -->
    <service name="PaymentGatewayService">

        <!-- PORT -->
        <port
            name="PaymentGatewayPort"
            binding="tns:PaymentSoapBinding">

            <soap:address
                location="https://payments.example.com/soap/PaymentGateway"/>

        </port>

    </service>

</definitions>